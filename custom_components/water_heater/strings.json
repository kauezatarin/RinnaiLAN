        "name": "Inlet temperature"
      },
      "outlet_temperature": {
        "name": "Outlet temperature"
      },
      "water_flow_rate": {
        "name": "Water flow rate"
      },
      "activations_count": {
        "name": "Activations count"
      },
      "combustion_hours": {
        "name": "Combustion hours"
      },
      "standby_hours": {
        "name": "Standby hours"
      },
      "wifi_signal": {
        "name": "Wi-Fi signal"
      }
    }
  }
