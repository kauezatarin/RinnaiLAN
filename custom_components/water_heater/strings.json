{
  "config": {
    "step": {
      "user": {
        "description": "Choose how you want to configure the Rinnai Water Heater.",
        "menu_options": {
          "manual": "Configure Device IP Manually",
          "invite": "Configure via Invite Code"
        }
      },
      "manual": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        }
      },
      "invite": {
        "description": "Enter the 6-digit numeric invite code.",
        "data": {
          "invite_code": "Invite Code"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_invite_code": "Invalid invite code",
      "network_prefix_not_found": "Could not determine local network prefix",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "entity": {
